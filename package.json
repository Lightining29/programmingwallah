    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.23.4",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
